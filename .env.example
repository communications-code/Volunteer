# Supabase Postgres
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Sessions, admin magic links, cron authorization
SESSION_SECRET="replace-with-a-long-random-secret"
CRON_SECRET="replace-with-a-long-random-secret"

# Canonical app/API URL on Vercel. Used for admin sign-in links and generated email links.
HOST_URL="https://apps.vfwharrisonoh.org"

# Public Wix page that embeds the Serving Network iframe.
PUBLIC_URL="https://vfwharrisonoh.org/volunteer/"
VITE_PUBLIC_URL="https://vfwharrisonoh.org/volunteer/"

# Email defaults
DEFAULT_FROM_EMAIL="communications@vfwharrisonoh.org"
CONTACT_EMAIL="communications@vfwharrisonoh.org"
CONTACT_PHONE="513-367-7570"
BRAND_LOGO_URL="https://apps.vfwharrisonoh.org/assets/vfw-logo-full-color.svg"

# Optional one-time admin bootstrap for a fresh environment.
# Remove these after the first successful admin login.
# INITIAL_ADMIN_EMAIL="admin@vfwharrisonoh.org"
# INITIAL_ADMIN_PASSWORD="replace-with-a-long-random-password"

# Transactional email
MAILERSEND_API_TOKEN="mlsn.xxxxx"
# Optional backward-compatible alias:
# MAILERSEND_API_KEY="mlsn.xxxxx"

# Optional email list integration. Leave unset if VFW is not using MailerLite yet.
# MAILERLITE_API_KEY="xxxxxx"
# MAILERLITE_SUPPORTERS_GROUP_ID="xxxxxx"

# Calendar sync inside the VFW Serving Network DB.
CALENDAR_SYNC_ENABLED="true"
CALENDAR_SOURCE_ORG_ID="vfw"
CALENDAR_COMPAT_BASE_URL=""
CALENDAR_COMPAT_TIMEOUT_MS="20000"

# Optional admin assistant for the dashboard ask/do bar.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-haiku-4-5"
